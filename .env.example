# ── Supabase (required) ───────────────────────────────────────
# Project URL from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon/public key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NEVER expose to browser, server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Gemini AI (required) ──────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Telegram (optional — users can set their own in Settings) ─
# Global fallback bot: create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Global fallback chat ID: get from @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# ── Gold Price API (optional) ─────────────────────────────────
# https://metalpriceapi.com — falls back to free source if blank
GOLD_API_KEY=

# ── Cron job (required for Vercel cron) ───────────────────────
# Generate: openssl rand -hex 32
CRON_SECRET=
