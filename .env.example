# ── Supabase ─────────────────────────────────────────────────────────────
# Project URL from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon/public key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — NEVER expose to browser, server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Gemini AI ──────────────────────────────────────────────────────
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Redis Cache ───────────────────────────────────────────────────────────
# Get from https://cloud.redis.io (free 30MB tier)
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Telegram Alerts (global fallback) ────────────────────────────────────
# Users can override with their own bot in Settings
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# ── Cron Authentication ───────────────────────────────────────────────────
# Random secret — protects /api/cron from unauthorized calls
# Generate with: openssl rand -hex 32
CRON_SECRET=
