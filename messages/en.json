  "learning": {
    "rsi": {
      "title": "What is RSI?",
      "body": "RSI (Relative Strength Index) measures how fast gold's price is moving. Above 70 means gold may be overbought (price could drop). Below 30 means gold may be oversold (price could rise)."
    },
    "macd": {
      "title": "What is MACD?",
      "body": "MACD shows the relationship between two moving averages. When the MACD line crosses above the signal line, it's a bullish sign. When it crosses below, it's bearish."
    },
    "ema": {
      "title": "What is EMA?",
      "body": "EMA (Exponential Moving Average) is a trend-following indicator. When price is above EMA20 and EMA50, gold is in an uptrend. When below, it's in a downtrend."
    },
    "signal": {
      "title": "How are signals generated?",
      "body": "Signals combine RSI, MACD, and EMA data, then AI analyzes all indicators together to produce a BUY, SELL, or HOLD recommendation with a confidence score."
    }
  },
